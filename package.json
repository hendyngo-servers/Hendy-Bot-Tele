{
  "name": "hendy-bot-tele-cloudflare",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:user": "vite build --config apps/web-user/vite.config.js",
    "build:admin": "vite build --config apps/web-admin/vite.config.js",
    "build": "npm run build:user && npm run build:admin",
    "dev:user": "vite --config apps/web-user/vite.config.js",
    "dev:admin": "vite --config apps/web-admin/vite.config.js",
    "dev:api": "wrangler dev --config workers/backend-api/wrangler.jsonc",
    "dev:router": "wrangler dev --config workers/edge-router/wrangler.jsonc",
    "dev:healing": "wrangler dev --config workers/self-healing/wrangler.jsonc",
    "deploy:api": "wrangler deploy --config workers/backend-api/wrangler.jsonc",
    "deploy:router": "wrangler deploy --config workers/edge-router/wrangler.jsonc",
    "deploy:healing": "wrangler deploy --config workers/self-healing/wrangler.jsonc",
    "deploy:user": "wrangler pages deploy apps/web-user/dist --project-name hendy-web-user",
    "deploy:admin": "wrangler pages deploy apps/web-admin/dist --project-name hendy-web-admin",
    "db:local": "wrangler d1 migrations apply hendy-production --local --config workers/backend-api/wrangler.jsonc",
    "db:remote": "wrangler d1 migrations apply hendy-production --remote --config workers/backend-api/wrangler.jsonc"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.1.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.45.0"
  }
}
