{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hendy-edge-router",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "services": [
    { "binding": "BACKEND", "service": "hendy-backend-api" }
  ],
  "vars": {
    "USER_PAGES_ORIGIN": "https://hendy-web-user.pages.dev",
    "ADMIN_PAGES_ORIGIN": "https://hendy-web-admin.pages.dev"
  }
}