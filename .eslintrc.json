{
  "root": true,
  "env": { "browser": true, "es2022": true, "node": true },
  "parserOptions": { "ecmaVersion": "latest", "sourceType": "module", "ecmaFeatures": { "jsx": true } },
  "rules": {
    "no-undef": "off",
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-eval": "error",
    "no-new-func": "error"
  }
}