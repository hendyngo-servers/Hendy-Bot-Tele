# Tao .env tu mau nay cho local. Tuyet doi khong commit secret that.
NODE_ENV=development
PORT=3000

# Telegram - nhap trong may local hoac Render Environment
BOT_TOKEN=
ADMIN_ID=
BOT_USERNAME=HendyBot_Bot
MINI_APP_URL=
WEBAPP_URL=

# MongoDB Atlas - connection string lay tu Atlas > Connect > Drivers
MONGODB_URI=
MONGODB_DB_NAME=hendy_bot

# Cloudflare D1/R2 legacy (chi dung neu can migration tu he thong cu)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Legacy PostgreSQL - chi dung tam thoi de import du lieu cu neu can
DATABASE_URL=
PGSSLMODE=
PGPOOL_MAX=5

# Runtime / encryption
DATA_DIR=./data
APP_ENCRYPTION_KEY=

# Payment defaults
BANK_BIN=
BANK_ACCOUNT=
BANK_ACCOUNT_NAME=
BANK_NAME=
MIN_DEPOSIT_VND=10000
SUPPORT_USERNAME=
