# Sao chép thành .env khi chạy local. Không commit credential thật.
NODE_ENV=development
PORT=3000

# Telegram — nhập token từ @BotFather và Telegram numeric user ID của Admin.
BOT_TOKEN=replace_with_new_bot_token
ADMIN_ID=replace_with_your_telegram_user_id
BOT_USERNAME=replace_with_bot_username
MINI_APP_URL=https://your-service.onrender.com
WEBAPP_URL=https://your-service.onrender.com

# File database và ảnh QR nằm trong DATA_DIR.
# Render Blueprint sử dụng Persistent Disk tại /var/data.
DATA_DIR=./data

# Sinh khóa cố định bằng:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Không thay khóa nếu đã có dữ liệu được mã hóa bằng khóa cũ.
APP_ENCRYPTION_KEY=replace_with_64_hex_characters

# Payment settings
BANK_BIN=
BANK_ACCOUNT=
BANK_ACCOUNT_NAME=
BANK_NAME=
MIN_DEPOSIT_VND=10000
SUPPORT_USERNAME=
