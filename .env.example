# Tao .env tu mau nay cho local. Khong commit secret that.
NODE_ENV=development
PORT=3000

# Telegram
BOT_TOKEN=
ADMIN_ID=
BOT_USERNAME=
MINI_APP_URL=
WEBAPP_URL=

# Cloudflare D1 (Cloudflare API Token requires D1 Read and D1 Write)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Cloudflare R2 S3 API credentials (separate from Cloudflare API token)
R2_BUCKET_NAME=hendy-bot-assets
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Legacy Render PostgreSQL - imported into D1 on first D1 startup when available
DATABASE_URL=
PGSSLMODE=
PGPOOL_MAX=5

# Runtime / encryption
DATA_DIR=./data
APP_ENCRYPTION_KEY=

# Payment defaults (can also be changed in Admin)
BANK_BIN=
BANK_ACCOUNT=
BANK_ACCOUNT_NAME=
BANK_NAME=
MIN_DEPOSIT_VND=10000
SUPPORT_USERNAME=
