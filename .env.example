# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
PORT=3000

# Telegram — replace with credentials from @BotFather and your own numeric Telegram user ID.
BOT_TOKEN=replace_with_new_bot_token
ADMIN_ID=replace_with_your_telegram_user_id
BOT_USERNAME=replace_with_bot_username
MINI_APP_URL=https://your-service.onrender.com
WEBAPP_URL=https://your-service.onrender.com

# MongoDB Atlas — use the FULL mongodb+srv:// URI from Atlas > Connect > Drivers.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_DB_NAME=hendy_bot
MONGO_MAX_POOL_SIZE=10

# Runtime / encryption
DATA_DIR=./data
# Generate a persistent random key with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep the same key permanently; changing it can make existing encrypted data unreadable.
APP_ENCRYPTION_KEY=replace_with_64_hex_characters

# Payment settings
BANK_BIN=
BANK_ACCOUNT=
BANK_ACCOUNT_NAME=
BANK_NAME=
MIN_DEPOSIT_VND=10000
SUPPORT_USERNAME=
