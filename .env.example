# Hendy Bot Telegram — local development / Render environment template
# Never commit real credentials. Copy to .env locally and replace every blank value.
PORT=10000
NODE_ENV=development
SET_WEBHOOK_ON_START=false

# Render public URL (optional locally; Render provides RENDER_EXTERNAL_URL automatically)
BASE_URL=
WEBAPP_URL=https://hendy-bot-miniapp.pages.dev
ADMIN_WEBAPP_URL=https://hendy-bot-miniapp.pages.dev
ALLOWED_ORIGINS=https://hendy-bot-miniapp.pages.dev

# Telegram — generate a NEW token in BotFather; do not reuse a token ever committed to Git.
BOT_TOKEN=
# Public bot username without @; used to produce genuine referral links.
BOT_USERNAME=
# Telegram webhook secret: use a random 32-byte hex value (openssl rand -hex 32).
# WEBHOOK_SECRET is stored only as a Render secret; the Worker forwards the header to Render.
WEBHOOK_SECRET=
ADMIN_TELEGRAM_IDS=

# Cloudflare D1 REST API (Render-only token: D1 read/write for this database)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_API_TOKEN=

# Cloudflare Worker URL (without /api suffix)
BACKUP_WORKER_URL=https://hendy-bot-tele-edge.<your-subdomain>.workers.dev
R2_UPLOAD_WORKER_URL=https://hendy-bot-tele-edge.<your-subdomain>.workers.dev
# Optional AES-256-GCM key used only by encryption helpers. Use 32+ random bytes if enabled.
ENCRYPTION_KEY=

# Secrets for the authenticated admin deployment-config controller.
RENDER_API_KEY=
RENDER_SERVICE_ID=
GITHUB_CONFIG_TOKEN=
GITHUB_REPOSITORY_OWNER=hendyngo-servers
GITHUB_REPOSITORY_NAME=Hendy-Bot-Tele

# Keep these values separate from BOT_TOKEN and WEBHOOK_SECRET.
BACKUP_TRIGGER_SECRET=
R2_UPLOAD_SECRET=

# Public payment / community configuration — use your own verified values.
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
GROUP_CHAT_URL=
NEWS_CHANNEL_URL=
SUPPORT_URL=

# Vite build-time API endpoint. The Mini App appends /api/... to this base URL.
VITE_API_BASE_URL=https://hendy-bot-tele-edge.<your-subdomain>.workers.dev
