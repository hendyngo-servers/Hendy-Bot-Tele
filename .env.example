# Tao .env tu mau nay cho local. Khong commit secret that.
NODE_ENV=development
PORT=3000

# Telegram
BOT_TOKEN=
ADMIN_ID=
BOT_USERNAME=
MINI_APP_URL=
WEBAPP_URL=

# PostgreSQL
DATABASE_URL=
# Databases outside Render must use TLS. Leave blank for Render internal URL.
PGSSLMODE=
PGPOOL_MAX=5

# Runtime / encryption
DATA_DIR=./data
APP_ENCRYPTION_KEY=

# Payment defaults (can also be changed in Admin)
BANK_BIN=
BANK_ACCOUNT=
BANK_ACCOUNT_NAME=
BANK_NAME=
MIN_DEPOSIT_VND=10000
SUPPORT_USERNAME=
