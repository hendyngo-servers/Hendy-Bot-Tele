# Runtime
PORT=3000
NODE_ENV=development
TELEGRAM_BOT_MODE=webhook
SET_WEBHOOK_ON_START=false
BASE_URL=https://your-render-service.onrender.com
WEBAPP_URL=https://your-user-app.pages.dev
ADMIN_WEBAPP_URL=https://your-admin-app.pages.dev
ALLOWED_ORIGINS=https://your-user-app.pages.dev,https://your-admin-app.pages.dev
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

# Telegram: never commit real credentials
BOT_TOKEN=
WEBHOOK_SECRET=
ADMIN_TELEGRAM_IDS=
BOT_USERNAME=

# Cloudflare D1 REST API (minimum permissions: D1 read/write for the target database)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Cloudflare Worker scheduled backup endpoint and shared secret.
# Set the same random BACKUP_TRIGGER_SECRET as a Worker secret.
BACKUP_WORKER_URL=https://your-worker.workers.dev
BACKUP_TRIGGER_SECRET=
R2_UPLOAD_WORKER_URL=https://your-worker.workers.dev
R2_UPLOAD_SECRET=
R2_UPLOAD_WORKER_URL=https://your-worker.workers.dev
R2_UPLOAD_SECRET=

# Optional public/payment settings (not API credentials)
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
GROUP_CHAT_URL=
NEWS_CHANNEL_URL=
SUPPORT_URL=
