# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
PORT=3000

# Telegram
BOT_TOKEN=
ADMIN_ID=
BOT_USERNAME=HendyBot_Bot
MINI_APP_URL=
WEBAPP_URL=

# MongoDB Atlas - get the URI from Atlas > Connect > Drivers
MONGODB_URI=
MONGODB_DB_NAME=hendy_bot
MONGO_MAX_POOL_SIZE=10

# Runtime / encryption
DATA_DIR=./data
APP_ENCRYPTION_KEY=

# Payment settings
BANK_BIN=
BANK_ACCOUNT=
BANK_ACCOUNT_NAME=
BANK_NAME=
MIN_DEPOSIT_VND=10000
SUPPORT_USERNAME=
